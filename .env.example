# Copiá este archivo como .env.local (local) y cargá las mismas variables en
# Vercel → Project → Settings → Environment Variables. NUNCA subas .env.local.

# --- Obligatoria ---------------------------------------------------------
# Clave de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de Gemini. Confirmá el nombre vigente en la doc oficial antes de
# usarlo: https://ai.google.dev/gemini-api/docs/models
# Probá primero con un modelo "Flash" (rápido y barato).
GEMINI_MODEL=gemini-3.8-flash

# --- Modo piloto (SIN Supabase) -----------------------------------------
# Mientras no configures Supabase, la API se protege con este PIN para que
# nadie pueda gastar tu cuota de Gemini. Elegí algo largo.
APP_PIN=

# --- Modo equipo (CON Supabase) ------------------------------------------
# Al completar ambas, la app exige un usuario de Supabase y deja de usar PIN.
# Se encuentran en Supabase → Project Settings → API.
# Usá la clave pública anon/publishable (la protege RLS).
# La service_role key NO se usa en este proyecto: no la cargues en ningún lado.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Gestión (preparado, PERO DESACTIVADO) -------------------------------
# No completes estos valores hasta tener documentación y credenciales de una API oficial.
# El conector del proyecto está bloqueado en código; aun con GESTION_ENABLED=true
# no hace llamadas externas hasta implementar y revisar el adaptador.
# Cargá secretos solo en .env.local (local) o en Environment Variables de Vercel.
GESTION_ENABLED=false
GESTION_API_BASE_URL=
GESTION_API_TOKEN=
GESTION_API_TIMEOUT_MS=8000
